# Copy to .env and fill in. Never commit .env.
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LOGFIRE_TOKEN=
DAILY_LIMIT=200
RATE_LIMIT=10/minute
# Rerank score below which the agent is told the evidence is weak (calibrate in eval)
WEAK_SCORE_THRESHOLD=0.0
# Optional: separate (ideally stronger) model for the eval judge
JUDGE_MODEL=
# Optional: comma-separated allowed CORS origins (empty = same-origin only)
CORS_ORIGINS=
# Optional: repo link shown in the UI header
GITHUB_URL=
# Optional: second model used if the main one keeps failing (e.g. 503 overloaded)
LLM_FALLBACK_MODEL=
